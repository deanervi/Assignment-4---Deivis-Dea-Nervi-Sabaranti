        {
          "name": "Success Create Labs",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "const responseData = pm.response.json();",
                  "",
                  "pm.environment.set(\"idLab\", responseData.data.id);",
                  "pm.environment.set(\"uniqueTitle\", responseData.data.title);",
                  "pm.environment.set(\"uniqueDescription\", responseData.data.description);",
                  "",
                  "const savedUserId = pm.environment.get(\"userId\");",
                  "const savedIdLab = pm.environment.get(\"idLab\");",
                  "const savedTitleLab = pm.environment.get(\"uniqueTitle\");",
                  "const savedDescLab = pm.environment.get(\"uniqueDescription\");",
                  "",
                  "pm.test(\"Validate response body\", function () {",
                  "    pm.expect(responseData.success).to.be.true;",
                  "    pm.expect(String(responseData.data.id)).to.equal(String(savedIdLab));",
                  "    pm.expect(responseData.data.title).to.equal(savedTitleLab);",
                  "    pm.expect(responseData.data.description).to.equal(savedDescLab);",
                  "    pm.expect(responseData.data.user_id).to.equal(savedUserId);",
                  "    pm.expect(responseData.message).to.equal(\"Lab added successfully\");",
                  "});",
                  "",
                  "pm.test(\"Response time is less than 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  ""

          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const responseData = pm.response.json();",
                  "",
                  "pm.environment.set(\"token\", responseData.data.token);",
                  "pm.environment.set(\"userId\", responseData.data.user.id);",
                  "pm.environment.set(\"email\", responseData.data.user.email);",
                  "pm.environment.set(\"role\", responseData.data.user.role);",
                  "pm.environment.set(\"status\", responseData.data.user.status);",
                  "",
                  "",
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Validate response body\", function () {",
                  "    pm.expect(responseData.success).to.be.true;",
                  "    pm.expect(responseData.message).to.equal(\"Login successful\");",
                  "    pm.expect(responseData.data.token).to.not.be.empty;",
                  "    pm.expect(responseData.data.user.id).to.not.be.empty;",
                  "    pm.expect(responseData.data.user.email).to.equal(\"deivis.dea@email.com\");",
                  "    pm.expect(responseData.data.user.role).to.equal(\"user\");",
                  "    pm.expect(responseData.data.user.status).to.equal(\"active\");",
                  "});",
                  "",
                  "pm.test(\"Response time is less than 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
